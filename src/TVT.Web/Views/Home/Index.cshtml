@model TVT.Web.ViewModels.Home.HomeViewModel


<div id="common-home" class="container">
    <div class="row row-padding-top">
        <div class="col-xl-9">
            <div id="ocdbanner-46" class="ocdbanner">

                <div class="banner-group group-grid">
                    <div class="respgrid respgrid-1" data-group="1" data-gutter="30">

                        <div class="item-grid item-grid-1" data-colspan="12" data-rowspan="6">
                            <div class="type-slider">
                                <div id="slider-1-1" class="splide slider-splide-1">
                                    <div class="splide__track">
                                        <div class="splide__list">

                                            @foreach (var slider in Model.Sliders)
                                            {
                                                <div class="splide__slide item-slide">

                                                    @if (!string.IsNullOrWhiteSpace(slider.TitleAz))
                                                    {
                                                        <a href="@slider.ButtonLink">
                                                            <img src="@slider.Image"
                                                                 title="@slider.TitleAz"
                                                                 alt="@slider.DescriptionAz"
                                                                 class="img-responsive" />
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <img src="@slider.Image"
                                                             title="@slider.TitleAz"
                                                             alt="@slider.DescriptionAz"
                                                             class="img-responsive" />
                                                    }

                                                </div>
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <script>
                    var settings = {
                        gutter: "30px",
                        itemclass: "#ocdbanner-46 .respgrid-1 .item-grid",
                        breakpoints: {
                            "*": {
                                range: "*",
                                options: {
                                    column: 12
                                }
                            }
                        }
                    };

                    respgrid("#ocdbanner-46 .respgrid-1", settings);
                </script>

                <script>
                    new Splide("#ocdbanner-46 #slider-1-1", {
                        rewind: true,
                        type: "loop",
                        perPage: 1,
                        autoplay: true,
                        interval: 3000
                    }).mount();
                </script>

            </div>
        </div>
        <div class="col-xl-3">
            <div id="ocdbanner-82" class="ocdbanner">

                <div class="banner-group group-bootstrap" data-group-rows="1">
                    <div class="row">

                        <div class="item-banner col-sm-12">
                            <div class="type-slider">
                                <div id="slider-1-1" class="splide slider-splide-1">
                                    <div class="splide__track">
                                        <div class="splide__list">

                                            @foreach (var miniSlider in Model.MiniSliders)
                                            {
                                                <div class="splide__slide item-slide">

                                                    @if (!string.IsNullOrWhiteSpace(miniSlider.Link))
                                                    {
                                                        <a href="@miniSlider.Link">
                                                            <img src="@miniSlider.Image"
                                                                 title=""
                                                                 alt=""
                                                                 class="img-responsive" />
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <img src="@miniSlider.Image"
                                                             title=""
                                                             alt=""
                                                             class="img-responsive" />
                                                    }

                                                </div>
                                            }

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <script>
                    new Splide("#ocdbanner-82 #slider-1-1", {
                        rewind: true,
                        type: "loop",
                        perPage: 1,
                        autoplay: true,
                        interval: 3000
                    }).mount();
                </script>

            </div>
        </div>
    </div>




</div>
