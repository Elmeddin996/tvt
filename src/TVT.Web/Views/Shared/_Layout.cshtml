@using System.Globalization
@using TVT.Business.Abstractions.Services
@using TVT.Web.Services
@using TVT.Web.ViewModels.Layout

@inject ISettingService SettingService
@inject ICategoryService CategoryService
@inject LocService localizer

@{
    var model = new LayoutViewModel
            {
                Setting = await SettingService.GetAsync(),
                Categories = await CategoryService.GetAllAsync()
            };

    var setting = model.Setting;

    var culture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    var address = culture switch
    {
        "en" => setting?.AddressEn,
        "ru" => setting?.AddressRu,
        _ => setting?.AddressAz
    };

    var workingHours = culture switch
    {
        "en" => setting?.WorkingHoursEn,
        "ru" => setting?.WorkingHoursRu,
        _ => setting?.WorkingHoursAz
    };

    var footerText = culture switch
    {
        "en" => setting?.FooterTextEn,
        "ru" => setting?.FooterTextRu,
        _ => setting?.FooterTextAz
    };

    var seoTitle = culture switch
    {
        "en" => setting?.DefaultSeoTitleEn,
        "ru" => setting?.DefaultSeoTitleRu,
        _ => setting?.DefaultSeoTitleAz
    };

    var seoDescription = culture switch
    {
        "en" => setting?.DefaultSeoDescriptionEn,
        "ru" => setting?.DefaultSeoDescriptionRu,
        _ => setting?.DefaultSeoDescriptionAz
    };

    var seoKeywords = culture switch
    {
        "en" => setting?.DefaultSeoKeywordsEn,
        "ru" => setting?.DefaultSeoKeywordsRu,
        _ => setting?.DefaultSeoKeywordsAz
    };
}

<!DOCTYPE html>

<html lang="@culture"
      dir="ltr"
      prefix="og: https://ogp.me/ns# fb: https://ogp.me/ns/fb# business: https://ogp.me/ns/business# place: http://ogp.me/ns/place#">
<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>
        @(ViewData["Title"] ?? seoTitle ?? setting?.CompanyName ?? "TVT")
    </title>

    <meta name="description"
          content="@(ViewData["Description"] ?? seoDescription ?? "")" />


    <meta name="keywords"
          content="@seoKeywords" />

    <meta name="author" content="TVT" />

    <meta name="robots" content="index,follow" />

    <base href="~/" />

    <!-- Open Graph -->
    <meta property="og:title"
          content="@(ViewData["Title"] ?? seoTitle ?? setting?.CompanyName ?? "TVT")" />
    <meta property="og:description"
          content="@(ViewData["Description"] ?? seoDescription ?? "")" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name"
          content="@setting?.CompanyName" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    @if (!string.IsNullOrWhiteSpace(setting?.Logo))
    {
        <meta property="og:image" content="@setting.Logo" />
    }

    <!-- Favicon -->
    <link rel="icon"
          type="image/png"
          href="~/images/favicon.png"
          asp-append-version="true" />

    <!-- Canonical -->
    <link rel="canonical"
          href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <!-- Preload Logo -->
    @if (!string.IsNullOrWhiteSpace(setting?.Logo))
    {
        <link rel="preload"
              as="image"
              href="@setting.Logo" />
    }

    <!-- CSS -->

    <link rel="stylesheet"
          href="~/css/contact.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/footer.css"
          asp-append-version="true" />

          <link rel="stylesheet" href="~/css/theme.css">

    <link rel="stylesheet"
          href="~/css/custom.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/catalog/view/theme/oct_remarket/stylesheet/oct-fonts.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- TVT Cart -->
    <script src="~/js/cart.js" asp-append-version="true"></script>
  
    <script src="~/js/search.js" asp-append-version="true"></script>

    <script src="~/js/theme.js"></script>
    <script src="~/js/wishlist.js" asp-append-version="true"></script>
    <script src="~/js/tvt.js" asp-append-version="true"></script>

    <!-- Structured Data -->
    <script type="application/ld+json">
        {
            "@@context":"https://schema.org",
            "@@type":"WebSite",
            "name":"TVT",
            "url":"https://tvt.az",
            "potentialAction":{
                "@@type":"SearchAction",
                "target":"https://tvt.az/search?search={search_term_string}",
                "query-input":"required name=search_term_string"
            }
        }
    </script>

</head>
<body>

    <!-- TVT Support Widget -->
    <div class="tvt-support-widget" id="tvt-support-widget">

        <div class="tvt-support-menu">

            @if (!string.IsNullOrWhiteSpace(setting?.Phone1))
            {
                <a href="tel:@setting.Phone1"
                   class="tvt-support-item tvt-support-call">

                    <span class="tvt-support-label">
                        @localizer.GetLocalizedHtmlString("Call")
                    </span>

                    <svg class="tvt-support-icon"
                         fill="currentColor"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 512 512">
                        <path d="M375.8 275.2c-16.4-7-35.4-2.4-46.7 11.4l-33.2 40.6c-46-26.7-84.4-65.1-111.1-111.1L225.3 183c13.8-11.3 18.5-30.3 11.4-46.7l-48-112C181.2 6.7 162.3-3.1 143.6.9l-112 24C13.2 28.8 0 45.1 0 64c0 0 0 0 0 0C0 300.7 183.5 494.5 416 510.9c4.5 .3 9.1 .6 13.7 .8c0 0 0 0 0 0c0 0 0 0 .1 0c6.1 .2 12.1 .4 18.3 .4c0 0 0 0 0 0c18.9 0 35.2-13.2 39.1-31.6l24-112c4-18.7-5.8-37.6-23.4-45.1l-112-48zM447.7 480C218.1 479.8 32 293.7 32 64c0 0 0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0s0 0 0 0c0-3.8 2.6-7 6.3-7.8l112-24c3.7-.8 7.5 1.2 9 4.7l48 112c1.4 3.3 .5 7.1-2.3 9.3l-40.6 33.2c-12.1 9.9-15.3 27.2-7.4 40.8c29.5 50.9 71.9 93.3 122.7 122.7c13.6 7.9 30.9 4.7 40.8-7.4l33.2-40.6c2.3-2.8 6.1-3.7 9.3-2.3l112 48c3.5 1.5 5.5 5.3 4.7 9l-24 112c-.8 3.7-4.1 6.3-7.8 6.3c-.1 0-.2 0-.3 0z" />
                    </svg>

                </a>
            }

            @if (!string.IsNullOrWhiteSpace(setting?.WhatsApp))
            {
                <a href="@setting.WhatsApp"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="tvt-support-item tvt-support-whatsapp">

                    <span class="tvt-support-label">
                        WhatsApp
                    </span>

                    <svg class="tvt-support-icon"
                         fill="currentColor"
                         xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 448 512">
                        <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" />
                    </svg>

                </a>
            }

        </div>

        <button type="button"
                id="tvt-support-main"
                class="tvt-support-main"
                aria-label="@localizer.GetLocalizedHtmlString("Contact")">

            <!-- CLOSED: chat -->
            <svg class="tvt-support-main-chat"
                 fill="currentColor"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 640 512">
                <path d="M32 176c0-74.8 73.7-144 176-144s176 69.2 176 144s-73.7 144-176 144c-15.3 0-30.6-1.9-46.3-5c-3.5-.7-7.1-.2-10.2 1.4c-6.1 3.1-12 6-18 8.7c-28.4 12.9-60.2 23.1-91.5 26c14.9-19 26.8-39.7 37.6-59.9c3.3-6.1 2.3-13.6-2.5-18.6C50 244.2 32 213.1 32 176zM208 0C93.1 0 0 78.9 0 176c0 44.2 19.8 80.1 46 110c-11.7 21-24 40.6-39.5 57.5c0 0 0 0 0 0l-.1 .1c-6.5 7-8.2 17.1-4.4 25.8C5.8 378.3 14.4 384 24 384c43 0 86.5-13.3 122.7-29.7c4.9-2.2 9.6-4.5 14.3-6.8c15.3 2.8 30.9 4.6 47 4.6c114.9 0 208-78.9 208-176S322.9 0 208 0zM447.4 160.5C541.6 167 608 233 608 304c0 37.1-18 68.2-45.1 96.6c-4.8 5-5.8 12.5-2.5 18.6c10.9 20.2 22.7 40.8 37.6 59.9c-31.3-3-63.2-13.2-91.5-26c-6-2.7-11.9-5.6-18-8.7c-3.2-1.6-6.8-2.1-10.2-1.4c-15.6 3.1-30.9 5-46.3 5c-68.2 0-123.6-30.7-153.1-73.3c-11 3-22.3 5.2-33.8 6.8C279 439.8 349.9 480 432 480c16.1 0 31.7-1.8 47-4.6c4.6 2.3 9.4 4.6 14.3 6.8C529.5 498.7 573 512 616 512c9.6 0 18.2-5.7 22-14.5c3.8-8.7 2-18.9-4.4-25.8l-.1-.1s0 0 0 0c-15.5-17-27.8-36.5-39.5-57.5c26.2-29.9 46-65.8 46-110c0-94.4-87.8-171.5-198.2-175.8c2.8 10.4 4.7 21.2 5.6 32.3z"></path>
            </svg>

            <!-- OPEN: X -->
            <svg class="tvt-support-main-close"
                 fill="currentColor"
                 xmlns="http://www.w3.org/2000/svg"
                 viewBox="0 0 384 512">
                <path d="M324.5 411.1c6.2 6.2 16.4 6.2 22.6 0s6.2-16.4 0-22.6L214.6 256 347.1 123.5c6.2-6.2 6.2-16.4 0-22.6s-16.4-16.4-22.6 0L192 233.4 59.6 100.9c-6.2-6.2-16.4-6.2-22.6 0s-6.2 16.4 0 22.6L169.4 256 36.9 388.5c-6.2 6.2-6.2 16.4 0 22.6s16.4 6.2 22.6 0L192 278.6 324.5 411.1z" />
            </svg>

        </button>

    </div>


    <div class="oct-fixed-bar fixed-right d-none d-lg-block">

        <div onclick="tvtCart.open();"
             class="oct-fixed-bar-item oct-fixed-bar-item-cart"
             title="@localizer.GetLocalizedHtmlString("Cart")">

            <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--fixed-bar-cart"
                              alt="@localizer.GetLocalizedHtmlString("Cart")"
                 width="24"
                 height="24">

            <span id="fixed-cart-quantity"
                  class="oct-fixed-bar-quantity oct-fixed-bar-quantity-cart">
                0
            </span>

        </div>

        <a asp-controller="Wishlist"
           asp-action="Index"
           class="oct-fixed-bar-item oct-fixed-bar-item-wishlist"
           title="@localizer.GetLocalizedHtmlString("Wishlist")"
           >

            <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--fixed-bar-wishlist"
                 alt="@localizer.GetLocalizedHtmlString("Wishlist")"
                 width="24"
                 height="20">

            <span class="oct-fixed-bar-quantity oct-fixed-bar-wishlist-quantity">
                0
            </span>

        </a>

    </div>
    <nav id="rm_mobile_nav"
         class="d-lg-none fixed-top d-flex align-items-center justify-content-between">



        <button type="button"
                id="rm_mobile_menu_button"
                class="rm-btn primary rm_mobile_sidebar_toggle"
                aria-label="@localizer.GetLocalizedHtmlString("Menu")">

            <span class="rm-btn-icon">
                <span></span>
                <span></span>
                <span></span>
            </span>

        </button>

        <div class="rm-mobile-nav-buttons d-flex">

            <button type="button"
                    class="rm-mobile-nav-buttons-btn rm-mobile-locatons-btn"
                    onclick="rmSidebar('@localizer.GetLocalizedHtmlString("Address")', 'locations');"
                    aria-label="@localizer.GetLocalizedHtmlString("Address")">

                <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--mobile-locations-icon"
                     alt="@localizer.GetLocalizedHtmlString("Address")"
                     width="20"
                     height="20">

            </button>

            <button type="button"
                    class="rm-mobile-nav-buttons-btn rm-mobile-contacts-btn"
                    onclick="rmSidebar('@localizer.GetLocalizedHtmlString("Contact")', 'contacts');"
                    aria-label="@localizer.GetLocalizedHtmlString("Contact")">

                <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--mobile-contacts-icon"
                     alt="@localizer.GetLocalizedHtmlString("Contact")"
                     width="21"
                     height="21">

            </button>

        </div>

    </nav>
    <div id="rm_sidebar" class="rm-sidebar">


        <div class="rm-sidebar-content">

            <div class="rm-sidebar-title d-flex alig-items-center justify-content-between">
                <span class="rm-sidebar-title-text">
                    @localizer.GetLocalizedHtmlString("Menu")
                </span>

                <span class="rm-sidebar-title-close modal-close">
                    <span aria-hidden="true" class="modal-close-icon modal-close-left"></span>
                    <span aria-hidden="true" class="modal-close-icon modal-close-right"></span>
                </span>
            </div>

           

            <div id="rm_sidebar_content"></div>


            <div id="rm_sidebar_contacts-template" class="d-none">

                <div class="rm-sidebar-contacts d-flex flex-column">

                    <div class="rm-header-location-inner">

                        @* Contact Phones *@
                        @if (!string.IsNullOrWhiteSpace(setting?.Phone1) ||
                        !string.IsNullOrWhiteSpace(setting?.Phone2))
                        {
                            <div class="rm_mobile_menu_first-item rm_mobile_menu_phones">

                                <div class="rm-content-title">
                                    @localizer.GetLocalizedHtmlString("ContactNumbers")
                                </div>

                                @if (!string.IsNullOrWhiteSpace(setting?.Phone1))
                                {
                                    <a href="@($"tel:{setting.Phone1}")"
                                       class="rm_mobile_menu_phones-item d-flex align-items-center">

                                        <span>@setting.Phone1</span>

                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(setting?.Phone2))
                                {
                                    <a href="@($"tel:{setting.Phone2}")"
                                       class="rm_mobile_menu_phones-item d-flex align-items-center">

                                        <span>@setting.Phone2</span>

                                    </a>
                                }

                            </div>
                        }


                        @* Working Hours *@
                        @if (!string.IsNullOrWhiteSpace(workingHours))
                        {
                            <div class="rm_mobile_menu_first-item rm_mobile_menu_shedule">

                                <div class="rm-content-title">
                                    @localizer.GetLocalizedHtmlString("WorkingHours")
                                </div>

                                <div>
                                    @workingHours
                                </div>

                            </div>
                        }


                        @* Messengers *@
                        @if (!string.IsNullOrWhiteSpace(setting?.Telegram) ||
                        !string.IsNullOrWhiteSpace(setting?.WhatsApp))
                        {
                            <div class="rm_mobile_menu_messengers row no-gutters">

                                @if (!string.IsNullOrWhiteSpace(setting?.Telegram))
                                {
                                    <div class="col-6">

                                        <a href="@setting.Telegram"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="rm_mobile_menu_first-item rm-fixed-contact-item d-flex align-items-center">

                                            <span class="rm-fixed-contact-item-icon rm-fixed-contact-telegram d-flex align-items-center justify-content-center">
                                                <i class="fab fa-telegram"></i>
                                            </span>

                                            <span>
                                                @localizer.GetLocalizedHtmlString("Telegram")
                                            </span>

                                        </a>

                                    </div>
                                }


                                @if (!string.IsNullOrWhiteSpace(setting?.WhatsApp))
                                {
                                    <div class="col-6">

                                        <a href="@setting.WhatsApp"
                                           target="_blank"
                                           rel="noopener noreferrer"
                                           class="rm_mobile_menu_first-item rm-fixed-contact-item d-flex align-items-center">

                                            <span class="rm-fixed-contact-item-icon rm-fixed-contact-whatsapp d-flex align-items-center justify-content-center">
                                                <i class="fab fa-whatsapp"></i>
                                            </span>

                                            <span>
                                                @localizer.GetLocalizedHtmlString("WhatsApp")
                                            </span>

                                        </a>

                                    </div>
                                }

                            </div>
                        }


                        @* Social Networks *@
                        @if (!string.IsNullOrWhiteSpace(setting?.Facebook) ||
                        !string.IsNullOrWhiteSpace(setting?.Instagram) ||
                        !string.IsNullOrWhiteSpace(setting?.Youtube) ||
                        !string.IsNullOrWhiteSpace(setting?.Telegram))
                        {
                            <div class="rm_mobile_menu_first-item rm_mobile_menu_shedule">

                                <div class="rm-content-title">
                                    @localizer.GetLocalizedHtmlString("SocialNetworks")
                                </div>

                                <ul class="rm-social list-unstyled d-flex flex-wrap">

                                    @if (!string.IsNullOrWhiteSpace(setting?.Facebook))
                                    {
                                        <li class="rm-social-item">

                                            <a href="@setting.Facebook"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="rm-social--fa-facebook-f d-flex align-items-center justify-content-center">

                                                <i class="fab fa-facebook-f"></i>

                                            </a>

                                        </li>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(setting?.Instagram))
                                    {
                                        <li class="rm-social-item">

                                            <a href="@setting.Instagram"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="rm-social--fa-instagram d-flex align-items-center justify-content-center">

                                                <i class="fab fa-instagram"></i>

                                            </a>

                                        </li>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(setting?.Youtube))
                                    {
                                        <li class="rm-social-item">

                                            <a href="@setting.Youtube"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="rm-social--fa-youtube d-flex align-items-center justify-content-center">

                                                <i class="fab fa-youtube"></i>

                                            </a>

                                        </li>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(setting?.Telegram))
                                    {
                                        <li class="rm-social-item">

                                            <a href="@setting.Telegram"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="rm-social--fa-telegram-plane d-flex align-items-center justify-content-center">

                                                <i class="fab fa-telegram-plane"></i>

                                            </a>

                                        </li>
                                    }

                                </ul>

                            </div>
                        }

                    </div>


                    @* Branches *@
                    <div class="d-flex justify-content-center rm-header-location-contacts-btn">

                        <a asp-controller="Contact"
                           asp-action="Index"
                           class="rm-btn dark w-100 text-center">

                            <span class="rm-btn-text">
                                @localizer.GetLocalizedHtmlString("OurAddress")
                            </span>

                        </a>

                    </div>



                </div>

            </div>



        </div>

    </div>

    <nav id="top" class="top-nav d-none d-lg-block">

        <div class="container d-flex justify-content-end">

            <div class="top-nav-account-links list-unstyled d-flex">

                <div id="oct_desktop_language"
                     class="top-nav-account-links-item rm-dropdown-box">

                    <div id="language" class="language">

                        <button type="button"
                                class="btn-lang rm-dropdown-toggle d-flex align-items-center">

                            @if (culture == "ru")
                            {
                                <img src="~/catalog/language/ru-ru/ru-ru.png"
                                     alt="Русский"
                                     title="Русский"
                                     class="lang"
                                     width="16"
                                     height="11" />
                            }
                            else if (culture == "en")
                            {
                                <img src="~/catalog/language/en-en/en-us.png"
                                     alt="English"
                                     title="English"
                                     class="lang"
                                     width="16"
                                     height="11" />
                            }
                            else
                            {
                                <img src="~/catalog/language/az-az/az-az.png"
                                     alt="Azərbaycan"
                                     title="Azərbaycan"
                                     class="lang"
                                     width="16"
                                     height="11" />
                            }

                            <span>
                                @localizer.GetLocalizedHtmlString("Language")
                            </span>

                        </button>

                        <div class="rm-dropdown">

                            <ul class="rm-dropdown-inner list-unstyled">

                                <!-- Azərbaycan -->

                                <li>
                                    <form asp-controller="Localization"
                                          asp-action="SetLanguage"
                                          method="post">

                                        <input type="hidden"
                                               name="culture"
                                               value="az-AZ" />

                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Context.Request.Path@Context.Request.QueryString" />

                                        <button type="submit"
                                                class="btn-block language-select @(culture == "az" ? "active-item" : "")">

                                            <img src="~/catalog/language/az-az/az-az.png"
                                                 alt="Azərbaycan"
                                                 title="Azərbaycan"
                                                 width="16"
                                                 height="11" />

                                            Azərbaycan

                                        </button>

                                    </form>
                                </li>

                                <!-- Русский -->

                                <li>
                                    <form asp-controller="Localization"
                                          asp-action="SetLanguage"
                                          method="post">

                                        <input type="hidden"
                                               name="culture"
