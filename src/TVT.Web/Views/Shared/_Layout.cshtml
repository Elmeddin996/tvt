                                            <img src="~/catalog/language/ru-ru/ru-ru.png"
                                                 alt="Русский"
                                                 title="Русский"
                                                 width="16"
                                                 height="11" />

                                            Русский

                                        </button>

                                    </form>
                                </li>

                                <!-- English -->

                                <li>
                                    <form asp-controller="Localization"
                                          asp-action="SetLanguage"
                                          method="post">

                                        <input type="hidden"
                                               name="culture"
                                               value="en-US" />

                                        <input type="hidden"
                                               name="returnUrl"
                                               value="@Context.Request.Path@Context.Request.QueryString" />

                                        <button type="submit"
                                                class="btn-block language-select @(culture == "en" ? "active-item" : "")">

                                            <img src="~/catalog/language/en-en/en-us.png"
