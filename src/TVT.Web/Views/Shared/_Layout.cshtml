<!DOCTYPE html>

<html lang="az"
      dir="ltr"
      prefix="og: https://ogp.me/ns# fb: https://ogp.me/ns/fb# business: https://ogp.me/ns/business# place: http://ogp.me/ns/place#">
<meta charset="utf-8" />
<head>
    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    <title>@ViewData["Title"] - TVT</title>

    <meta name="description"
          content="@(ViewData["Description"] ?? "TVT Elektronika və Texnologiya Məhsulları")" />

    <meta name="keywords"
          content="TVT, Elektronika, Kamera, Təhlükəsizlik sistemləri, Şəbəkə avadanlıqları" />

    <meta name="author" content="TVT" />

    <meta name="robots" content="index,follow" />

    <base href="~/" />

    <!-- Open Graph -->
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@(ViewData["Description"] ?? "TVT Elektronika və Texnologiya Məhsulları")" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="TVT" />
    <meta property="og:url" content="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    <meta property="og:image" content="~/images/logo.png" />

    <!-- Favicon -->
    <link rel="icon"
          type="image/png"
          href="~/images/favicon.png"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/custom.css"
          asp-append-version="true" />

    <!-- Canonical -->
    <link rel="canonical"
          href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />

    <!-- Preload Logo -->
    <link rel="preload"
          as="image"
          href="~/images/logo.png" />

    <!-- CSS -->
    

          <link rel="stylesheet" href="~/css/theme.css">

    <link rel="stylesheet"
          href="~/css/custom.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/catalog/view/theme/oct_remarket/stylesheet/oct-fonts.css">

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

    <!-- JavaScript -->
   

    <script src="~/js/search.js" asp-append-version="true"></script>

    <script src="~/js/theme.js"></script>

    <!-- Structured Data -->
    <script type="application/ld+json">
        {
            "@@context":"https://schema.org",
            "@@type":"WebSite",
            "name":"TVT",
            "url":"https://tvt.az",
            "potentialAction":{
                "@@type":"SearchAction",
                "target":"https://tvt.az/search?search={search_term_string}",
                "query-input":"required name=search_term_string"
            }
        }
    </script>

</head>
<body>
    <div class="oct-fixed-bar fixed-right d-none d-lg-block">

        <div onclick="octPopupCart();"
             class="oct-fixed-bar-item oct-fixed-bar-item-cart"
             title="Səbət">

            <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--fixed-bar-cart"
                 alt="Səbət"
                 width="24"
                 height="24">

            <span class="oct-fixed-bar-quantity oct-fixed-bar-quantity-cart">
                0
            </span>

        </div>

        <a asp-controller="Compare"
           asp-action="Index"
           class="oct-fixed-bar-item oct-fixed-bar-item-compare"
           title="Müqayisə">

            <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--fixed-bar-compare"
                 alt="Müqayisə"
                 width="24"
                 height="24">

            <span class="oct-fixed-bar-quantity oct-fixed-bar-compare-quantity">
                0
            </span>

        </a>

        <a asp-controller="Wishlist"
           asp-action="Index"
           class="oct-fixed-bar-item oct-fixed-bar-item-wishlist"
           title="İstək siyahısı">

            <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--fixed-bar-wishlist"
