@model TVT.Web.ViewModels.Layout.LayoutViewModel

@using System.Globalization
@using TVT.Web.Services
@inject LocService localizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    var address = currentCulture switch
    {
        "en" => Model.Setting?.AddressEn,
        "ru" => Model.Setting?.AddressRu,
        _ => Model.Setting?.AddressAz
    };

    var workingHours = currentCulture switch
    {
        "en" => Model.Setting?.WorkingHoursEn,
        "ru" => Model.Setting?.WorkingHoursRu,
        _ => Model.Setting?.WorkingHoursAz
    };
}


<header>
    <div class="container-fluid container-sm">
        <div class="row align-items-center flex-column flex-md-row">
            <div class="col-md-3 col-lg-2 order-0">
                <div id="logo" class="d-flex align-items-center justify-content-center">

                    <a asp-controller="Home" asp-action="Index">
                        <img src="@(string.IsNullOrWhiteSpace(Model.Setting?.Logo)
                             ? Url.Content("~/images/logo.png")
                             : Model.Setting?.Logo)"
                             alt="@(Model.Setting?.CompanyName ?? "TVT")"
                             class="img-fluid"
                             width="141"
                             height="64" />
                    </a>

                </div>
            </div>
            <div class="col-2 d-none d-lg-block order-1">

                <button id="menu_toggle_button"
                        type="button"
                        class="rm-btn primary d-flex align-items-center justify-content-between"
                        aria-label="@localizer.GetLocalizedHtmlString("ProductCatalog")">

                    <span class="rm-btn-icon">

                        <img class="catalog-icon"
                             src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--footer-catalog-icon"
                             alt="@localizer.GetLocalizedHtmlString("ProductCatalog")"
                             width="14"
                             height="14" />

                        <img class="close-icon"
                             src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--close-catalog-icon"
                             alt="@localizer.GetLocalizedHtmlString("Close")"
                             width="14"
                             height="14" />

                    </span>

                    <span class="rm-btn-text">
                        @localizer.GetLocalizedHtmlString("ProductCatalog")
                    </span>

                </button>

            </div>
            <div class="col-12 col-md-6 col-lg-4 order-3 order-md-2 mt-lg-2 mt-xl-3">
                <form id="search"
                      class="rm-search"
                      asp-controller="Search"
                      asp-action="Index"
                      method="get">

                    <input id="input_search"
                           type="text"
                           name="q"
                           value="@Context.Request.Query["q"]"
                           placeholder="@localizer.GetLocalizedHtmlString("Search")"
                           class="w-100 h-100" />

                    <button type="submit"
                            id="rm-search-button"
                            class="btn-search d-flex align-items-center justify-content-center"
                            aria-label="@localizer.GetLocalizedHtmlString("Search")">

                        <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--header-search-icon"
                             alt="@localizer.GetLocalizedHtmlString("Search")"
                             width="20"
                             height="20" />

                    </button>

                    <div id="rm_livesearch_close"
                         onclick="clearLiveSearch();"
                         class="d-flex align-items-center justify-content-center">

                        <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--livesearch-close-icon"
                             alt="@localizer.GetLocalizedHtmlString("Close")"
                             width="25"
                             height="25" />

                    </div>

                    <div id="rm_livesearch"></div>

                </form>

                <div class="rm-header-address d-none d-lg-block">

                    <div class="rm-dropdown-box w-100">

                        <div class="rm-dropdown-toggle">

                            <span>
                                @localizer.GetLocalizedHtmlString("Address")
                            </span>

                            <span class="rm-header-address-link">
                                @address
                            </span>

                        </div>

                        <div class="rm-dropdown">

                            <div id="rm_header_locations" class="rm-dropdown-inner">

                                <div class="rm-header-location active">

                                    <div class="d-flex align-items-center">

                                        <div class="rm-header-location-address">
                                            @address
                                        </div>

                                        <button class="rm-btn secondary ml-auto">

                                            <span class="rm-btn-icon">

                                                <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--header-location-chevron"
                                                     alt=""
                                                     width="18"
                                                     height="12" />

                                            </span>

                                        </button>

                                    </div>

                                    <div class="rm-header-location-collapsed">

                                        <div class="rm-header-location-phones">

                                            <span>
                                                @localizer.GetLocalizedHtmlString("ContactNumbers")
                                            </span>

                                            <a href="tel:@Model.Setting?.Phone1">
                                                @Model.Setting?.Phone1
                                            </a>

                                        </div>

                                        <div class="rm-header-location-shedule">

                                            <span>
                                                @localizer.GetLocalizedHtmlString("WorkingHours")
                                            </span>

                                            <br />

                                            <span>
                                                @workingHours
                                            </span>

                                        </div>

                                        <div class="rm-header-location-map">
                                        </div>

                                    </div>

                                </div>

                            </div>
                        </div>

                    </div>

                </div>
            </div>
            <div class="col-12 col-md-3 col-lg-2 d-none d-md-flex justify-content-center order-2 order-md-3">

                <div class="rm-header-phones d-flex align-items-center">

                    <div class="rm-header-phones-icon">
                        <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--header-phones-icon"
                             alt="@localizer.GetLocalizedHtmlString("Phone")"
                             width="30"
                             height="30" />
                    </div>

                    <div class="rm-header-phones-list">

                        @if (!string.IsNullOrWhiteSpace(Model.Setting?.Phone1))
                        {
                            <a href="tel:@Model.Setting?.Phone1"
                               class="rm-header-phones-list-item">
                                @Model.Setting?.Phone1
                            </a>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.Setting?.Phone2))
                        {
                            <a href="tel:@Model.Setting?.Phone2"
                               class="rm-header-phones-list-item">
                                @Model.Setting?.Phone2
                            </a>
                        }

                    </div>

                </div>

            </div>
            <div class="col-md-2 d-lg-flex justify-content-center order-4">

                <button id="cart"
                        type="button"
                        class="rm-header-cart d-flex flex-column align-items-center"
                        title="@localizer.GetLocalizedHtmlString("Cart")"
                        onclick="tvtCart.open();">

                    <span class="rm-header-cart-icon position-relative">

                        <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--header-cart-icon"
                             alt="@localizer.GetLocalizedHtmlString("Cart")"
                             width="21"
                             height="21" />

                        <span id="cart-quantity" class="rm-header-cart-quantity">
                            0
                        </span>

                    </span>

                    <span id="cart-total" class="rm-header-cart-text">
                        00 ₼
                    </span>

                </button>

            </div>


            <partial name="_CategoryMenu" model="Model" />


        </div>
    </div>
</header>
