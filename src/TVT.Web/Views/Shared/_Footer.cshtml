@model TVT.Web.ViewModels.Layout.LayoutViewModel

<footer class="tvt-footer">

    <div class="container">

        <div class="tvt-footer-main">

            <!-- Company -->
            <div class="tvt-footer-column tvt-footer-company">

                @if (!string.IsNullOrWhiteSpace(Model.Setting?.Logo))
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="tvt-footer-logo">

                        <img src="@Model.Setting.Logo"
                             alt="@Model.Setting.CompanyName" />

                    </a>
                }
                else if (!string.IsNullOrWhiteSpace(Model.Setting?.CompanyName))
                {
                    <a asp-controller="Home"
                       asp-action="Index"
                       class="tvt-footer-company-name">

                        @Model.Setting.CompanyName

                    </a>
                }

                @if (!string.IsNullOrWhiteSpace(Model.Setting?.FooterTextAz))
                {
                    <div class="tvt-footer-description">
                        @Html.Raw(Model.Setting.FooterTextAz)
                    </div>
                }

                <div class="tvt-footer-social">

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Facebook))
                    {
                        <a href="@Model.Setting.Facebook"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Facebook">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Instagram))
                    {
                        <a href="@Model.Setting.Instagram"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Instagram">
                            <i class="fab fa-instagram"></i>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Youtube))
                    {
                        <a href="@Model.Setting.Youtube"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="YouTube">
                            <i class="fab fa-youtube"></i>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Telegram))
                    {
                        <a href="@Model.Setting.Telegram"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="Telegram">
                            <i class="fab fa-telegram-plane"></i>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.WhatsApp))
                    {
                        <a href="@Model.Setting.WhatsApp"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="WhatsApp">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.TikTok))
                    {
                        <a href="@Model.Setting.TikTok"
                           target="_blank"
                           rel="noopener noreferrer"
                           aria-label="TikTok">
                            <i class="fab fa-tiktok"></i>
                        </a>
                    }

                </div>

            </div>


            <!-- Contact -->
            <div class="tvt-footer-column">

                <h4 class="tvt-footer-title">
                    Əlaqə
                </h4>

                <ul class="tvt-footer-list">

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Phone1))
                    {
                        <li>

                            <i class="fas fa-phone-alt"></i>

                            <a href="@($"tel:{Model.Setting.Phone1}")">
                                @Model.Setting.Phone1
                            </a>

                        </li>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Phone2))
                    {
                        <li>

                            <i class="fas fa-phone-alt"></i>

                            <a href="@($"tel:{Model.Setting.Phone2}")">
                                @Model.Setting.Phone2
                            </a>

                        </li>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.Email))
                    {
                        <li>

                            <i class="fas fa-envelope"></i>

                            <a href="mailto:@Model.Setting.Email">
                                @Model.Setting.Email
                            </a>

                        </li>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Setting?.AddressAz))
                    {
                        <li>

                            <i class="fas fa-map-marker-alt"></i>

                            <span>
                                @Model.Setting.AddressAz
                            </span>

                        </li>
                    }

                </ul>

            </div>


            <!-- Working Hours -->
            <div class="tvt-footer-column">

                <h4 class="tvt-footer-title">
                    İş vaxtı
                </h4>

                @if (!string.IsNullOrWhiteSpace(Model.Setting?.WorkingHoursAz))
                {
                    <div class="tvt-footer-working-hours">
                        @Html.Raw(Model.Setting.WorkingHoursAz)
                    </div>
                }

                <a asp-controller="Contact"
                   asp-action="Index"
                   class="tvt-footer-contact-button">

                    Əlaqə səhifəsi

                </a>

            </div>


            <!-- Information -->
            <div class="tvt-footer-column">

                <h4 class="tvt-footer-title">
                    Məlumat
                </h4>

                <ul class="tvt-footer-links">

                    <li>
                        <a asp-controller="Home"
                           asp-action="Index">
                            Ana səhifə
                        </a>
                    </li>

                    <li>
                        <a asp-controller="Contact"
                           asp-action="Index">
                            Əlaqə
                        </a>
                    </li>

                   

                </ul>

            </div>

        </div>


        <!-- Footer Bottom -->
        <div class="tvt-footer-bottom">

            <div>
                © 2026
                @Model.Setting?.CompanyName.
                Bütün hüquqlar qorunur.
            </div>

            <a href="https://wa.me/994505481996"
               target="_blank"
               rel="noopener noreferrer"
               class="tvt-footer-developer">
                Created by Elmeddin Mirzeyev
            </a>

        </div>

    </div>

</footer>
