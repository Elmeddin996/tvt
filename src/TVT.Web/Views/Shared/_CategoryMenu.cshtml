@model TVT.Web.ViewModels.Layout.LayoutViewModel

@using TVT.Web.Resources
@using TVT.Web.Services
@inject LocService localizer

@{
    var categories = Model.Categories;

    var parents = categories
        .Where(x => x.ParentId == null)
        .ToList();

    var currentCulture = System.Globalization.CultureInfo.CurrentUICulture
        .TwoLetterISOLanguageName;
}

<style>
    .rm-menu-list-item-name {
        display: inline-block;
        font-family: Montserrat, sans-serif;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.1rem;
        color: #272323;
    }
</style>


<!-- ========================================================= -->
<!-- DESKTOP CATEGORY MENU -->
<!-- ========================================================= -->

<div id="rm-menu" class="rm-menu d-flex">
    <nav>
        <ul class="rm-menu-list list-unstyled">

            @foreach (var parent in parents)
            {
                var children = categories
                .Where(x => x.ParentId == parent.Id)
                .ToList();

                <li class="rm-menu-list-item">

                    <div class="d-flex align-items-center justify-content-between">

                        <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? parent.SlugEn
        : currentCulture == "ru"
            ? parent.SlugRu
            : parent.SlugAz
})"
                           class="rm-menu-list-item-link d-flex align-items-center">

                            @if (!string.IsNullOrWhiteSpace(parent.Icon))
                            {
                                <img class="tvt-mobile-menu-icon"
                                     src="@parent.Icon"
                                     alt="@(currentCulture == "en"
                    ? parent.NameEn
                    : currentCulture == "ru"
                        ? parent.NameRu
                        : parent.NameAz)"
                                     width="38"
                                     height="38" />
                            }

                            <span class="rm-menu-list-item-name" style="margin-left: 15px;">
                                @(currentCulture == "en"
                                    ? parent.NameEn
                                    : currentCulture == "ru"
                                    ? parent.NameRu
                                    : parent.NameAz)
                            </span>

                        </a>

                        @if (children.Any())
                        {
                            <span class="rm-menu-list-item-chevron"></span>
                        }

                    </div>


                    @if (children.Any())
                    {
                        <div class="rm-menu-list-item-child">

                            <ul class="rm-menu-list list-unstyled">

                                @foreach (var child in children)
                                {
                                    var thirdLevel = categories
                                    .Where(x => x.ParentId == child.Id)
                                    .ToList();

                                    <li class="rm-menu-list-item">

                                        <div class="d-flex align-items-center justify-content-between">

                                            <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? child.SlugEn
        : currentCulture == "ru"
            ? child.SlugRu
            : child.SlugAz
})"
                                               class="rm-menu-list-item-link d-flex align-items-center">

                                                <span class="rm-menu-list-item-name">
                                                    @(currentCulture == "en"
                                                        ? child.NameEn
                                                        : currentCulture == "ru"
                                                        ? child.NameRu
                                                        : child.NameAz)
                                                </span>

                                            </a>

                                            @if (thirdLevel.Any())
                                            {
                                                <span class="rm-menu-list-item-chevron"></span>
                                            }

                                        </div>


                                        @if (thirdLevel.Any())
                                        {
                                            <div class="rm-menu-list-item-child rm-menu-list-item-child-2">

                                                <ul class="rm-menu-list list-unstyled">

                                                    @foreach (var subChild in thirdLevel)
                                                    {
                                                        <li class="rm-menu-list-item">

                                                            <div class="d-flex align-items-center justify-content-between">

                                                                <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? subChild.SlugEn
        : currentCulture == "ru"
            ? subChild.SlugRu
            : subChild.SlugAz
})"
                                                                   class="rm-menu-list-item-link d-flex align-items-center">

                                                                    <span class="rm-menu-list-item-name">
                                                                        @(currentCulture == "en"
                                                                            ? subChild.NameEn
                                                                            : currentCulture == "ru"
                                                                            ? subChild.NameRu
                                                                            : subChild.NameAz)
                                                                    </span>

                                                                </a>

                                                            </div>

                                                        </li>
                                                    }

                                                </ul>

                                            </div>
                                        }

                                    </li>
                                }

                            </ul>

                        </div>
                    }

                </li>
            }

        </ul>
    </nav>
</div>


<!-- ========================================================= -->
<!-- MOBILE CATEGORY MENU -->
<!-- ========================================================= -->

<div id="tvt-mobile-menu" class="tvt-mobile-menu">

    <div class="tvt-mobile-menu-header">

        <button type="button"
                class="tvt-mobile-menu-back"
                id="tvt-mobile-menu-back"
                aria-label="@localizer.GetLocalizedHtmlString("Back")">
            <span class="tvt-mobile-menu-back-icon"></span>
            <span id="tvt-mobile-menu-back-text"></span>
        </button>

        <button type="button"
                class="tvt-mobile-menu-close"
                id="tvt-mobile-menu-close"
                aria-label="@localizer.GetLocalizedHtmlString("Close")">
            <span></span>
            <span></span>
        </button>

    </div>


    <div class="tvt-mobile-menu-content">

        <!-- LEVEL 0 - MAIN MOBILE MENU -->

        <div class="tvt-mobile-menu-level active"
             id="tvt-mobile-menu-main"
             data-level="0"
             data-title="@localizer.GetLocalizedHtmlString("Menu")">

            <div class="tvt-mobile-menu-title">
                @localizer.GetLocalizedHtmlString("Menu")
            </div>

            <div class="tvt-mobile-menu-list">

                <div class="tvt-mobile-menu-item">

                    <button type="button"
                            class="tvt-mobile-menu-link tvt-mobile-menu-catalog-link"
                            data-target="tvt-mobile-menu-catalog">

                        <span class="tvt-mobile-menu-catalog-icon">
                            <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--mobile-menu-icon"
                                 alt=""
                                 width="18"
                                 height="18" />
                        </span>

                        <span class="tvt-mobile-menu-catalog-text">
                            @localizer.GetLocalizedHtmlString("ProductCatalog")
                        </span>

                    </button>

                    <button type="button"
                            class="tvt-mobile-menu-next"
                            data-target="tvt-mobile-menu-catalog"
                            aria-label="@localizer.GetLocalizedHtmlString("ProductCatalog")"

                        <span></span>

                    </button>

                </div>

                <a asp-controller="Wishlist"
                   asp-action="Index"
                   class="tvt-mobile-menu-link tvt-mobile-menu-wishlist-link"
                   style="padding-left:16px;">

                    <span class="tvt-mobile-menu-wishlist-icon" style="background: rgb(0, 103, 173) !important;">
                        <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--fixed-bar-wishlist"
                             alt="@localizer.GetLocalizedHtmlString("Wishlist")"
                             width="20"
                             height="20" />
                    </span>

                    <span class="tvt-mobile-menu-wishlist-text">
                        @localizer.GetLocalizedHtmlString("Wishlist")
                    </span>

                </a>

                <!-- Contact -->
                <a asp-controller="Contact"
                   asp-action="Index"
                   class="tvt-mobile-menu-link tvt-mobile-menu-contact-link"
                   style="padding-left:16px;">

                    <span class="tvt-mobile-menu-contact-icon"
                          style="display:flex; align-items:center; justify-content:center; width:24px; height:24px; flex:0 0 24px; margin-right:12px; background:rgb(0, 103, 173); border-radius:2px;">

                        <img src="~/catalog/view/theme/oct_remarket/img/sprite.svg#include--mobile-contacts-icon"
                             alt="@localizer.GetLocalizedHtmlString("Contact")"
                             width="20"
                             height="20"
                             style="filter: brightness(0) invert(1);" />

                    </span>

                    <span class="tvt-mobile-menu-contact-text">
                        @localizer.GetLocalizedHtmlString("Contact")
                    </span>

                </a>


                <!-- Branches -->
                <a asp-controller="Branch"
                   asp-action="Index"
                   class="tvt-mobile-menu-link tvt-mobile-menu-contact-link"
                   style="padding-left:16px;">

                    <span class="tvt-mobile-menu-contact-icon"
                          style="display:flex; align-items:center; justify-content:center; width:24px; height:24px; flex:0 0 24px; margin-right:12px; background:rgb(0, 103, 173); border-radius:2px;">

                        <i class="fas fa-store"
                           style="color:#fff; font-size:14px;">
                        </i>

                    </span>

                    <span class="tvt-mobile-menu-contact-text">
                        @localizer.GetLocalizedHtmlString("Branches")
                    </span>

                </a>

                <div class="tvt-mobile-language-switcher d-flex justify-content-center align-items-center">

                    <!-- Azərbaycan -->
                    <form asp-controller="Localization"
                          asp-action="SetLanguage"
                          method="post">

                        <input type="hidden"
                               name="culture"
                               value="az-AZ" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@Context.Request.Path@Context.Request.QueryString" />

                        <button type="submit"
                                class="tvt-mobile-language-btn @(currentCulture  == "az" ? "active" : "")"
                                title="Azərbaycan">

                            <img src="~/catalog/language/az-az/az-az.png"
                                 alt="Azərbaycan"
                                 width="16"
                                 height="11" />

                        </button>

                    </form>


                    <!-- English -->
                    <form asp-controller="Localization"
                          asp-action="SetLanguage"
                          method="post">

                        <input type="hidden"
                               name="culture"
                               value="en-US" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@Context.Request.Path@Context.Request.QueryString" />

                        <button type="submit"
                                class="tvt-mobile-language-btn @(currentCulture  == "en" ? "active" : "")"
                                title="English">

                            <img src="~/catalog/language/en-en/en-us.png"
                                 alt="English"
                                 width="16"
                                 height="11" />

                        </button>

                    </form>


                    <!-- Русский -->
                    <form asp-controller="Localization"
                          asp-action="SetLanguage"
                          method="post">

                        <input type="hidden"
                               name="culture"
                               value="ru-RU" />

                        <input type="hidden"
                               name="returnUrl"
                               value="@Context.Request.Path@Context.Request.QueryString" />

                        <button type="submit"
                                class="tvt-mobile-language-btn @(currentCulture  == "ru" ? "active" : "")"
                                title="Русский">

                            <img src="~/catalog/language/ru-ru/ru-ru.png"
                                 alt="Русский"
                                 width="16"
                                 height="11" />

                        </button>

                    </form>

                </div>

            </div>

        </div>



        <!-- LEVEL 1 - PRODUCT CATALOG -->

        <div class="tvt-mobile-menu-level"
             id="tvt-mobile-menu-catalog"
             data-level="1"
             data-title="@localizer.GetLocalizedHtmlString("ProductCatalog")"
             data-parent="tvt-mobile-menu-main">



            <div class="tvt-mobile-menu-list">

                @foreach (var parent in parents)
                {
                    var children = categories
                    .Where(x => x.ParentId == parent.Id)
                    .ToList();

                    <div class="tvt-mobile-menu-item">

                        <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? parent.SlugEn
        : currentCulture == "ru"
            ? parent.SlugRu
            : parent.SlugAz
})"
                           class="tvt-mobile-menu-link">

                            @if (!string.IsNullOrWhiteSpace(parent.Icon))
                            {
                                <img class="tvt-mobile-menu-icon"
                                     src="@parent.Icon"
                                     alt="@(currentCulture == "en"
                    ? parent.NameEn
                    : currentCulture == "ru"
                        ? parent.NameRu
                        : parent.NameAz)"
                                     width="33"
                                     height="33" />
                            }

                            <span>
                                @(currentCulture == "en"
                                    ? parent.NameEn
                                    : currentCulture == "ru"
                                    ? parent.NameRu
                                    : parent.NameAz)
                            </span>

                        </a>

                        @if (children.Any())
                        {
                            <button type="button"
                                    class="tvt-mobile-menu-next"
                                    data-target="tvt-mobile-parent-@parent.Id"
                                    aria-label="@localizer.GetLocalizedHtmlString("Subcategories")">

                                <span></span>

                            </button>
                        }

                    </div>
                }

            </div>

        </div>



        <!-- LEVEL 2 - CATEGORY CHILDREN -->
        @foreach (var parent in parents)
        {
            var children = categories
            .Where(x => x.ParentId == parent.Id)
            .ToList();

            if (!children.Any())
                continue;

            <div class="tvt-mobile-menu-level"
                 id="tvt-mobile-parent-@parent.Id"
                 data-level="2"
                 data-title="@(currentCulture == "en"
    ? parent.NameEn
    : currentCulture == "ru"
        ? parent.NameRu
        : parent.NameAz)"
                 data-parent="tvt-mobile-menu-catalog">



                <div class="tvt-mobile-menu-list">

                    @foreach (var child in children)
                    {
                        var thirdLevel = categories
                        .Where(x => x.ParentId == child.Id)
                        .ToList();

                        <div class="tvt-mobile-menu-item">

                            <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? child.SlugEn
        : currentCulture == "ru"
            ? child.SlugRu
            : child.SlugAz
})"
                               class="tvt-mobile-menu-link">

                                <span>
                                    @(currentCulture == "en"
                                        ? child.NameEn
                                        : currentCulture == "ru"
                                        ? child.NameRu
                                        : child.NameAz)
                                </span>

                            </a>

                            @if (thirdLevel.Any())
                            {
                                <button type="button"
                                        class="tvt-mobile-menu-next"
                                        data-target="tvt-mobile-child-@child.Id"
                                        aria-label="@localizer.GetLocalizedHtmlString("Subcategories")">

                                    <span></span>

                                </button>
                            }

                        </div>
                    }

                </div>

            </div>
        }


        <!-- LEVEL 2 / THIRD LEVEL -->
        @foreach (var child in categories.Where(x => x.ParentId != null))
        {
            var thirdLevel = categories
            .Where(x => x.ParentId == child.Id)
            .ToList();

            if (!thirdLevel.Any())
                continue;

            <div class="tvt-mobile-menu-level"
                 id="tvt-mobile-child-@child.Id"
                 data-level="3"
                 data-title="@(currentCulture == "en"
    ? child.NameEn
    : currentCulture == "ru"
        ? child.NameRu
        : child.NameAz)"
                 data-parent="tvt-mobile-parent-@child.ParentId">



                <div class="tvt-mobile-menu-list">

                    @foreach (var subChild in thirdLevel)
                    {
                        <div class="tvt-mobile-menu-item">

                            <a href="@Url.RouteUrl("category", new
{
    culture = currentCulture,
    slug = currentCulture == "en"
        ? subChild.SlugEn
        : currentCulture == "ru"
            ? subChild.SlugRu
            : subChild.SlugAz
})"
                               class="tvt-mobile-menu-link">

                                <span>
                                    @(currentCulture == "en"
                                        ? subChild.NameEn
                                        : currentCulture == "ru"
                                        ? subChild.NameRu
                                        : subChild.NameAz)
                                </span>

                            </a>

                        </div>
                    }

                </div>

            </div>
        }



    </div>



</div>
