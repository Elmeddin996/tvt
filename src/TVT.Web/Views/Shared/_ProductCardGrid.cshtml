@model TVT.Business.DTOs.Products.ProductListDto

@using System.Globalization
@using TVT.Web.Services
@inject LocService localizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    var productName = currentCulture switch
    {
        "en" => Model.NameEn,
        "ru" => Model.NameRu,
        _ => Model.NameAz
    };

    var productSlug = currentCulture switch
    {
        "en" => Model.SlugEn,
        "ru" => Model.SlugRu,
        _ => Model.SlugAz
    };

    var image = string.IsNullOrWhiteSpace(Model.MainImage)
        ? "/images/no-image.png"
        : Model.MainImage;
}

<div class="col-12 col-md-4 col-xl-3 rm-module-col"
     data-width="width-50">

    <div class="rm-module-item d-flex flex-md-column h-100 @(Model.StockQuantity <= 0 ? "rm-no-stock" : "")">

        <div class="rm-module-img d-flex flex-column d-md-block">

            @if (Model.IsNew)
            {
                <div class="rm-module-stickers">

                    <div class="rm-module-stickers-sticker rm-module-stickers-sticker-stickers_new">
                        @localizer.GetLocalizedHtmlString("New")
                    </div>

                    @if (Model.StockQuantity <= 0)
                    {
                        <div class="rm-module-stickers-sticker rm-module-stickers-sticker-stickers_sold">
                            @localizer.GetLocalizedHtmlString("OutOfStock")
                        </div>
                    }

                </div>
            }
            else if (Model.StockQuantity <= 0)
            {
                <div class="rm-module-stickers">

                    <div class="rm-module-stickers-sticker rm-module-stickers-sticker-stickers_sold">
                        @localizer.GetLocalizedHtmlString("OutOfStock")
                    </div>

                </div>
            }

            <div class="rm-module-buttons list-unstyled d-flex justify-content-center flex-md-column order-1">

                <button type="button"
                        aria-label="@localizer.GetLocalizedHtmlString("Wishlist")"
                        title="@localizer.GetLocalizedHtmlString("AddToWishlist")"
                        onclick="tvtWishlist.toggle(@Model.Id);"
                        data-wishlist-product-id="@Model.Id"
                        class="rm-module-buttons-item wishlist d-flex align-items-center justify-content-center">

                    <span></span>

                </button>

            </div>

            <div class="scale">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-slug="@productSlug"
                   class="order-0">

                    <img src="@image"
                         data-srcset="@image"
                         srcset="@image"
                         sizes="100vw"
                         class="img-fluid oct-lazy"
                         alt="@productName"
                         title="@productName"
                         width="300"
                         height="300" />

                </a>

            </div>

            <input type="hidden"
                   name="product_id"
                   value="@Model.Id" />

        </div>

        <div class="rm-module-caption d-flex flex-column flex-grow-1">

            <div class="rm-module-title">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-slug="@productSlug">

                    @productName

                </a>

            </div>

            @if (Model.StockQuantity > 0)
            {
                <div class="rm-module-stock">

                    @localizer.GetLocalizedHtmlString("InStock")

                </div>
            }
            else
            {
                <div class="rm-module-stock rm-out-of-stock">

                    @localizer.GetLocalizedHtmlString("OutOfStock")

                </div>
            }

            <div class="rm-category-product-model">

                <span>
                    @localizer.GetLocalizedHtmlString("ProductCode"):
                </span>

                @Model.Code

            </div>

            <div class="rm-module-price-box d-flex flex-column mt-auto">

                @if (Model.OldPrice.HasValue && Model.OldPrice > Model.Price)
                {
                    <span class="rm-module-price-old">

                        @Model.OldPrice.Value.ToString("0.##") ₼

                    </span>
                }

                <div class="rm-module-price-bottom d-flex align-items-md-end justify-content-between flex-column flex-md-row mt-md-auto flex-grow-1">

                    <span class="rm-module-price">

                        @Model.Price.ToString("0.##") ₼

                    </span>

                    <button type="button"
                            aria-label="@localizer.GetLocalizedHtmlString("AddToCart")"
                            class="rm-btn secondary rm-cart-btn d-flex align-items-center justify-content-center justify-content-md-start"
                            onclick="tvtCart.add(@Model.Id, 1)">

                        <span class="rm-cart-btn-icon"></span>

                        <span class="rm-btn-text">
                            @localizer.GetLocalizedHtmlString("AddToCart")
                        </span>

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>
