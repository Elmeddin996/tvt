@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Admin Login - TVT</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <style>
        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f5f6f8;
        }

        .login-box {
            width: 100%;
            max-width: 400px;
            background: #fff;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
        }

        .login-title {
            text-align: center;
            margin-bottom: 30px;
        }

            .login-title h2 {
                margin-bottom: 5px;
            }

            .login-title p {
                color: #777;
                margin: 0;
            }
    </style>
</head>

<body>

    <div class="login-box">

        <div class="login-title">
            <h2>TVT Admin</h2>
            <p>Admin panelə giriş</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">
                @ViewBag.Error
            </div>
        }

        <form asp-area="Admin"
              asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">
                    İstifadəçi adı
                </label>

                <input type="text"
                       name="username"
                       class="form-control"
                       autocomplete="username"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">
                    Şifrə
                </label>

                <input type="password"
                       name="password"
                       class="form-control"
                       autocomplete="current-password"
                       required />
            </div>

            <button type="submit"
                    class="btn btn-primary w-100">
                Daxil ol
            </button>

        </form>

    </div>

</body>
</html>
