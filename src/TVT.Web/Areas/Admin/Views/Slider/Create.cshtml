@model TVT.Web.Areas.Admin.ViewModels.Sliders.CreateSliderViewModel

@{
    ViewData["Title"] = "Create Slider";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Create Slider</h5>

        <a asp-area="Admin"
           asp-controller="Slider"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <div class="card-body">

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Slider.TitleAz" class="form-label"></label>
                <input asp-for="Slider.TitleAz" class="form-control" />
                <span asp-validation-for="Slider.TitleAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.TitleEn" class="form-label"></label>
                <input asp-for="Slider.TitleEn" class="form-control" />
                <span asp-validation-for="Slider.TitleEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.TitleRu" class="form-label"></label>
                <input asp-for="Slider.TitleRu" class="form-control" />
                <span asp-validation-for="Slider.TitleRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.DescriptionAz" class="form-label"></label>
                <textarea asp-for="Slider.DescriptionAz"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Slider.DescriptionAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.DescriptionEn" class="form-label"></label>
                <textarea asp-for="Slider.DescriptionEn"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Slider.DescriptionEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.DescriptionRu" class="form-label"></label>
                <textarea asp-for="Slider.DescriptionRu"
                          class="form-control"
                          rows="4"></textarea>
                <span asp-validation-for="Slider.DescriptionRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.ButtonTextAz" class="form-label"></label>
                <input asp-for="Slider.ButtonTextAz" class="form-control" />
                <span asp-validation-for="Slider.ButtonTextAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.ButtonTextEn" class="form-label"></label>
                <input asp-for="Slider.ButtonTextEn" class="form-control" />
                <span asp-validation-for="Slider.ButtonTextEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.ButtonTextRu" class="form-label"></label>
                <input asp-for="Slider.ButtonTextRu" class="form-control" />
                <span asp-validation-for="Slider.ButtonTextRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.ButtonLink" class="form-label"></label>
                <input asp-for="Slider.ButtonLink"
                       class="form-control"
                       placeholder="https://example.com" />
                <span asp-validation-for="Slider.ButtonLink" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Slider.DisplayOrder" class="form-label"></label>
                <input asp-for="Slider.DisplayOrder"
                       class="form-control"
                       type="number"
                       min="0" />
                <span asp-validation-for="Slider.DisplayOrder" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label">Image</label>

                <input asp-for="ImageFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" />

                <span asp-validation-for="ImageFile"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Slider.IsActive" class="form-check-input" />
                <label asp-for="Slider.IsActive" class="form-check-label"></label>
            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-area="Admin"
                   asp-controller="Slider"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg"></i>
                    Save
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
