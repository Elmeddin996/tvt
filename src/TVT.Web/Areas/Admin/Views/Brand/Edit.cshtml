@model TVT.Web.Areas.Admin.ViewModels.Brands.EditBrandViewModel

@{
    ViewData["Title"] = "Edit Brand";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Edit Brand</h5>

        <a asp-area="Admin"
           asp-controller="Brand"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <div class="card-body">

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input asp-for="Brand.Id" type="hidden" />
            <input asp-for="Brand.Logo" type="hidden" />

            <div class="mb-3">
                <label asp-for="Brand.NameAz" class="form-label"></label>
                <input asp-for="Brand.NameAz" class="form-control" />
                <span asp-validation-for="Brand.NameAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.NameEn" class="form-label"></label>
                <input asp-for="Brand.NameEn" class="form-control" />
                <span asp-validation-for="Brand.NameEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.NameRu" class="form-label"></label>
                <input asp-for="Brand.NameRu" class="form-control" />
                <span asp-validation-for="Brand.NameRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.SlugAz" class="form-label"></label>
                <input asp-for="Brand.SlugAz" class="form-control" />
                <span asp-validation-for="Brand.SlugAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.SlugEn" class="form-label"></label>
                <input asp-for="Brand.SlugEn" class="form-control" />
                <span asp-validation-for="Brand.SlugEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.SlugRu" class="form-label"></label>
                <input asp-for="Brand.SlugRu" class="form-control" />
                <span asp-validation-for="Brand.SlugRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.DescriptionAz" class="form-label"></label>
                <textarea asp-for="Brand.DescriptionAz" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Brand.DescriptionAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.DescriptionEn" class="form-label"></label>
                <textarea asp-for="Brand.DescriptionEn" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Brand.DescriptionEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.DescriptionRu" class="form-label"></label>
                <textarea asp-for="Brand.DescriptionRu" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Brand.DescriptionRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Brand.Website" class="form-label"></label>
                <input asp-for="Brand.Website"
                       class="form-control"
                       placeholder="https://example.com" />
                <span asp-validation-for="Brand.Website" class="text-danger"></span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Brand.Logo))
            {
                <div class="mb-3">
                    <label class="form-label">Current Logo</label>

                    <div>
                        <img src="@Model.Brand.Logo"
                             class="img-thumbnail"
                             style="max-width:200px;" />
                    </div>
                </div>
            }

            <div class="mb-3">
                <label asp-for="LogoFile" class="form-label">New Logo</label>

                <input asp-for="LogoFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" />

                <span asp-validation-for="LogoFile"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Brand.IsActive" class="form-check-input" />
                <label asp-for="Brand.IsActive" class="form-check-label"></label>
            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-area="Admin"
                   asp-controller="Brand"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg"></i>
                    Update
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
