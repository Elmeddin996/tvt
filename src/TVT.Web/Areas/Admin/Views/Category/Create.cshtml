@model TVT.Web.Areas.Admin.ViewModels.Categories.CreateCategoryViewModel

@{
    ViewData["Title"] = "Create Category";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Create Category</h5>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <div class="card-body">
        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Category.NameAz" class="form-label"></label>
                <input asp-for="Category.NameAz" class="form-control" />
                <span asp-validation-for="Category.NameAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.NameEn" class="form-label"></label>
                <input asp-for="Category.NameEn" class="form-control" />
                <span asp-validation-for="Category.NameEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.NameRu" class="form-label"></label>
                <input asp-for="Category.NameRu" class="form-control" />
                <span asp-validation-for="Category.NameRu" class="text-danger"></span>
            </div>


            <div class="mb-3">
                <label asp-for="Category.ParentId" class="form-label">
                    Parent Category
                </label>

                <select asp-for="Category.ParentId"
                        asp-items="Model.ParentCategories"
                        class="form-select">
                    <option value="">Main Category</option>
                </select>

                <span asp-validation-for="Category.ParentId"
                      class="text-danger"></span>
            </div>


            <div class="mb-3">
                <label asp-for="Category.SlugAz" class="form-label"></label>
                <input asp-for="Category.SlugAz" class="form-control" />
                <span asp-validation-for="Category.SlugAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.SlugEn" class="form-label"></label>
                <input asp-for="Category.SlugEn" class="form-control" />
                <span asp-validation-for="Category.SlugEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.SlugRu" class="form-label"></label>
                <input asp-for="Category.SlugRu" class="form-control" />
                <span asp-validation-for="Category.SlugRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.DescriptionAz" class="form-label"></label>
                <textarea asp-for="Category.DescriptionAz" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Category.DescriptionAz" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.DescriptionEn" class="form-label"></label>
                <textarea asp-for="Category.DescriptionEn" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Category.DescriptionEn" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Category.DescriptionRu" class="form-label"></label>
                <textarea asp-for="Category.DescriptionRu" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Category.DescriptionRu" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ImageFile" class="form-label">Image</label>

                <input asp-for="ImageFile"
                       type="file"
                       class="form-control"
                       accept=".jpg,.jpeg,.png,.webp" />

                <span asp-validation-for="ImageFile"
                      class="text-danger"></span>
            </div>

            <div class="form-check mb-4">
                <input asp-for="Category.IsActive" class="form-check-input" />
                <label asp-for="Category.IsActive" class="form-check-label"></label>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <a asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-lg"></i>
                    Save
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
