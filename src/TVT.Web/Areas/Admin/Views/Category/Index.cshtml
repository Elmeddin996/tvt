@using TVT.Core.Common.Pagination
@model PagedResult<TVT.Business.DTOs.Categories.CategoryListDto>
    
@{
    ViewData["Title"] = "Categories";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Category List</h5>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Create"
           class="btn btn-success">
            <i class="bi bi-plus-lg"></i>
            Add Category
        </a>
    </div>

    <div class="card-body border-bottom">
        <form method="get" class="row g-2" role="search">

            <div class="col-md-4">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>

            <div class="col-auto">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Reset
                </a>
            </div>

        </form>
    </div>

    <div class="card-body p-0">

        @if (!Model.Items.Any())
        {
            <div class="alert alert-info m-3">
                No categories found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;">Id</th>
                            <th>Name</th>
                            <th>Parent</th>
                            <th>Slug</th>
                            <th>Status</th>
                            <th>Created</th>
                            <th class="text-center" style="width:220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var category in Model.Items)
                        {
                            <tr>

                                <td>@category.Id</td>

                                <td>@category.NameAz</td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(category.ParentName))
                                    {
                                        <span class="badge bg-secondary">
                                            Main Category
                                        </span>
                                    }
                                    else
                                    {
                                        @category.ParentName
                                    }
                                </td>

                                <td>@category.SlugAz</td>
                                <td>
                                    @if (category.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Passive
                                        </span>
                                    }
                                </td>

                                <td>
                                    @category.CreatedDate.ToString("dd.MM.yyyy")
                                </td>

                                <td class="text-center">

                                   

                                    <a asp-action="Edit"
                                       asp-route-id="@category.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@category.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this category?')">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>
            </div>

            @if (Model.TotalPages > 1)
            {
                <div class="d-flex justify-content-center py-3">

                    <nav>
                        <ul class="pagination mb-0">

                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage - 1)"
                                   asp-route-search="@ViewBag.Search">
                                    Previous
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPages; i++)
                            {
                                <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-page="@i"
                                       asp-route-search="@ViewBag.Search">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@(Model.CurrentPage + 1)"
                                   asp-route-search="@ViewBag.Search">
                                    Next
                                </a>
                            </li>

                        </ul>
                    </nav>

                </div>
            }
        }

    </div>
</div>
