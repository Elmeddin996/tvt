@using TVT.Core.Common.Pagination
@using TVT.Business.DTOs.Branches
@model PagedResult<BranchListDto>

@{
    ViewData["Title"] = "Branches";

    var search = ViewBag.Search as string;
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-1">Branches</h1>
            <p class="text-muted mb-0">
                Manage your store branches.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Branch"
           asp-action="Create"
           class="btn btn-primary">
            <i class="bi bi-plus-lg"></i>
            Add Branch
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show"
             role="alert">
            @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show"
             role="alert">
            @TempData["Error"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <form asp-area="Admin"
                  asp-controller="Branch"
                  asp-action="Index"
                  method="get">

                <div class="row g-2">

                    <div class="col-md-8 col-lg-9">
                        <input type="text"
                               name="search"
                               value="@search"
                               class="form-control"
                               placeholder="Search branches..." />
                    </div>

                    <div class="col-md-4 col-lg-3 d-flex gap-2">

                        <button type="submit"
                                class="btn btn-outline-primary flex-fill">
                            <i class="bi bi-search"></i>
                            Search
                        </button>

                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <a asp-area="Admin"
                               asp-controller="Branch"
                               asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }

                    </div>

                </div>

            </form>

        </div>

        <div class="card-body p-0">

            @if (Model.Items.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>

                                <th style="width:80px;">
                                    Order
                                </th>

                                <th style="width:90px;">
                                    Image
                                </th>

                                <th>
                                    Branch
                                </th>

                                <th>
                                    Address
                                </th>

                                <th>
                                    Phone
                                </th>

                                <th style="width:100px;">
                                    Status
                                </th>

                                <th style="width:150px;"
                                    class="text-end">
                                    Actions
                                </th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var branch in Model.Items)
                            {
                                <tr>

                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            @branch.DisplayOrder
                                        </span>
                                    </td>

                                    <td>

                                        @if (!string.IsNullOrWhiteSpace(branch.Image))
                                        {
                                            <img src="@branch.Image"
                                                 alt="@branch.NameAz"
                                                 style="width:60px;height:45px;object-fit:cover;border-radius:4px;" />
                                        }
                                        else
                                        {
                                            <div class="d-flex align-items-center justify-content-center bg-light border rounded"
                                                 style="width:60px;height:45px;">
                                                <i class="bi bi-building text-muted"></i>
                                            </div>
                                        }

                                    </td>

                                    <td>
                                        <div class="fw-semibold">
                                            @branch.NameAz
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(branch.NameEn))
                                        {
                                            <small class="text-muted">
                                                @branch.NameEn
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        <span>
                                            @branch.AddressAz
                                        </span>
                                    </td>

                                    <td>
                                        <a href="tel:@branch.Phone">
                                            @branch.Phone
                                        </a>

                                        @if (!string.IsNullOrWhiteSpace(branch.Phone2))
                                        {
                                            <br />

                                            <small class="text-muted">
                                                @branch.Phone2
                                            </small>
                                        }
                                    </td>

                                    <td>

                                        @if (branch.IsActive)
                                        {
                                            <span class="badge bg-success">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                Inactive
                                            </span>
                                        }

                                    </td>

                                    <td class="text-end">

                                        <div class="d-inline-flex gap-1">

                                            <a asp-area="Admin"
                                               asp-controller="Branch"
                                               asp-action="Edit"
                                               asp-route-id="@branch.Id"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Edit">
                                                <i class="bi bi-pencil"></i>
                                            </a>

                                            <form asp-area="Admin"
                                                  asp-controller="Branch"
                                                  asp-action="Delete"
                                                  asp-route-id="@branch.Id"
                                                  method="post"
                                                  class="d-inline"
                                                  onsubmit="return confirm('Are you sure you want to delete this branch?');">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-outline-danger"
                                                        title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <div class="mb-3">
                        <i class="bi bi-building fs-1 text-muted"></i>
                    </div>

                    <h5>No branches found</h5>

                    @if (!string.IsNullOrWhiteSpace(search))
                    {
                        <p class="text-muted">
                            No branches matched your search.
                        </p>

                        <a asp-area="Admin"
                           asp-controller="Branch"
                           asp-action="Index"
                           class="btn btn-outline-secondary">
                            Clear Search
                        </a>
                    }
                    else
                    {
                        <p class="text-muted">
                            You haven't added any branches yet.
                        </p>

                        <a asp-area="Admin"
                           asp-controller="Branch"
                           asp-action="Create"
                           class="btn btn-primary">
                            <i class="bi bi-plus-lg"></i>
                            Add First Branch
                        </a>
                    }

                </div>
            }

        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white">

                <div class="d-flex justify-content-between align-items-center">

                    <div class="text-muted small">
                        Showing
                        @(((Model.CurrentPage - 1) * Model.PageSize) + 1)
                        -
                        @(Math.Min(
                            Model.CurrentPage * Model.PageSize,
                            Model.TotalCount))
                        of
                        @Model.TotalCount
                    </div>

                    <nav aria-label="Branch pagination">

                        <ul class="pagination mb-0">

                            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">

                                @if (Model.HasPreviousPage)
                                {
                                    <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="Branch"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage - 1)"
                                       asp-route-search="@search">
                                        Previous
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Previous
                                    </span>
                                }

                            </li>

                            @for (var pageNumber = 1;
                           pageNumber <= Model.TotalPages;
                           pageNumber++)
                            {
                                <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">

                                    <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="Branch"
                                       asp-action="Index"
                                       asp-route-page="@pageNumber"
                                       asp-route-search="@search">
                                        @pageNumber
                                    </a>

                                </li>
                            }

                            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">

                                @if (Model.HasNextPage)
                                {
                                    <a class="page-link"
                                       asp-area="Admin"
                                       asp-controller="Branch"
                                       asp-action="Index"
                                       asp-route-page="@(Model.CurrentPage + 1)"
                                       asp-route-search="@search">
                                        Next
                                    </a>
                                }
                                else
                                {
                                    <span class="page-link">
                                        Next
                                    </span>
                                }

                            </li>

                        </ul>

                    </nav>

                </div>

            </div>
        }

    </div>

</div>
