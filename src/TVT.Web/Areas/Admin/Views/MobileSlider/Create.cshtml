@model TVT.Web.Areas.Admin.ViewModels.MobileSliders.CreateMobileSliderViewModel

@{
    ViewData["Title"] = "Create Mobile Slider";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">
                Create Mobile Slider
            </h2>

            <p class="text-muted mb-0">
                Add a slider image for mobile devices.
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="MobileSlider"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>

    </div>


    <div class="card">

        <div class="card-body">

            <form asp-area="Admin"
                  asp-controller="MobileSlider"
                  asp-action="Create"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <!-- Image -->

                <div class="mb-3">

                    <label asp-for="ImageFile"
                           class="form-label">
                        Image
                    </label>

                    <input asp-for="ImageFile"
                           type="file"
                           class="form-control"
                           accept="image/*" />

                    <span asp-validation-for="ImageFile"
                          class="text-danger">
                    </span>

                    <div class="form-text">
                        Upload the mobile slider image.
                    </div>

                </div>


                <!-- Link -->

                <div class="mb-3">

                    <label asp-for="MobileSlider.Link"
                           class="form-label">
                        Link
                    </label>

                    <input asp-for="MobileSlider.Link"
                           class="form-control"
                           placeholder="https://example.com/..." />

                    <span asp-validation-for="MobileSlider.Link"
                          class="text-danger">
                    </span>

                </div>


                <!-- Sort Order -->

                <div class="mb-3">

                    <label asp-for="MobileSlider.SortOrder"
                           class="form-label">
                        Sort Order
                    </label>

                    <input asp-for="MobileSlider.SortOrder"
                           type="number"
                           class="form-control"
                           min="0"
                           value="0" />

                    <span asp-validation-for="MobileSlider.SortOrder"
                          class="text-danger">
                    </span>

                </div>


                <!-- Active -->

                <div class="form-check mb-4">

                    <input asp-for="MobileSlider.IsActive"
                           class="form-check-input" />

                    <label asp-for="MobileSlider.IsActive"
                           class="form-check-label">
                        Active
                    </label>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">
                        Create
                    </button>

                    <a asp-area="Admin"
                       asp-controller="MobileSlider"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
