@model TVT.Web.Areas.Admin.ViewModels.Specifications.UpdateSpecificationViewModel

@{
    ViewData["Title"] = "Edit Specification";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Edit Specification</h5>

        <a asp-action="Index"
           class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Back to List
        </a>
    </div>

    <div class="card-body">

        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Specification.Id" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Specification.SpecificationGroupId" class="form-label"></label>

                <select asp-for="Specification.SpecificationGroupId"
                        asp-items="Model.SpecificationGroups"
                        class="form-select"></select>

                <span asp-validation-for="Specification.SpecificationGroupId"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Specification.NameAz" class="form-label"></label>

                <input asp-for="Specification.NameAz"
                       class="form-control" />

                <span asp-validation-for="Specification.NameAz"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Specification.NameEn" class="form-label"></label>

                <input asp-for="Specification.NameEn"
                       class="form-control" />

                <span asp-validation-for="Specification.NameEn"
                      class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Specification.NameRu" class="form-label"></label>

                <input asp-for="Specification.NameRu"
                       class="form-control" />

                <span asp-validation-for="Specification.NameRu"
                      class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Specification.DisplayOrder"
                       class="form-label"></label>

                <input asp-for="Specification.DisplayOrder"
                       class="form-control" />

                <span asp-validation-for="Specification.DisplayOrder"
                      class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-end gap-2">

                <a asp-action="Index"
                   class="btn btn-outline-secondary">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-primary">
                    <i class="bi bi-check-lg"></i>
                    Update
                </button>

            </div>

        </form>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
