@model TVT.Business.DTOs.Orders.OrderDetailDto

@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<partial name="_PageHeader" />


@if (TempData["Success"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">

        <i class="bi bi-check-circle me-2"></i>

        @successMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


@if (TempData["Error"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">

        <i class="bi bi-exclamation-triangle me-2"></i>

        @errorMessage

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert">
        </button>

    </div>
}


<div class="row g-4">

    <!-- =========================
         CUSTOMER INFORMATION
    ========================== -->

    <div class="col-lg-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    Customer Information
                </h5>

            </div>


            <div class="card-body">

                <div class="mb-3">

                    <div class="text-muted small">
                        Name
                    </div>

                    <div class="fw-semibold">
                        @Model.CustomerName
                    </div>

                </div>


                <div class="mb-3">

                    <div class="text-muted small">
                        Phone
                    </div>

                    <div class="fw-semibold">
                        @Model.Phone
                    </div>

                </div>


                <div class="mb-3">

                    <div class="text-muted small">
                        Email
                    </div>

                    <div class="fw-semibold">

                        @if (!string.IsNullOrWhiteSpace(Model.Email))
                        {
                            @Model.Email
                        }
                        else
                        {
                            <span class="text-muted">
                                -
                            </span>
                        }

                    </div>

                </div>


                <div>

                    <div class="text-muted small">
                        Address
                    </div>

                    <div class="fw-semibold">
                        @Model.Address
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         ORDER INFORMATION
    ========================== -->

    <div class="col-lg-6">

        <div class="card shadow-sm border-0 h-100">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    Order Information
                </h5>

            </div>


            <div class="card-body">

                <div class="mb-3">

                    <div class="text-muted small">
                        Order Number
                    </div>

                    <div class="fw-semibold">
                        #@Model.Id
                    </div>

                </div>


                <div class="mb-3">

                    <div class="text-muted small">
                        Created
                    </div>

                    <div class="fw-semibold">
                        @Model.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                    </div>

                </div>


                <div class="mb-3">

                    <div class="text-muted small mb-2">
                        Status
                    </div>


                    <form asp-action="UpdateStatus"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@Model.Id" />


                        <div class="input-group">

                            <select name="status"
                                    class="form-select">

                                <option value="Pending"
                                        selected="@(Model.Status == "Pending")">
                                    Pending
                                </option>

                                <option value="Confirmed"
                                        selected="@(Model.Status == "Confirmed")">
                                    Confirmed
                                </option>

                                <option value="Preparing"
                                        selected="@(Model.Status == "Preparing")">
                                    Preparing
                                </option>

                                <option value="Shipped"
                                        selected="@(Model.Status == "Shipped")">
                                    Shipped
                                </option>

                                <option value="Delivered"
                                        selected="@(Model.Status == "Delivered")">
                                    Delivered
                                </option>

                                <option value="Cancelled"
                                        selected="@(Model.Status == "Cancelled")">
                                    Cancelled
                                </option>

                            </select>


                            <button type="submit"
                                    class="btn btn-primary">

                                <i class="bi bi-check-lg me-1"></i>

                                Update

                            </button>

                        </div>

                    </form>

                </div>


                <div>

                    <div class="text-muted small">
                        Total Amount
                    </div>

                    <div class="fs-4 fw-bold">
                        @Model.TotalAmount.ToString("0.00") AZN
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================
         ORDER ITEMS
    ========================== -->

    <div class="col-12">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-white">

                <h5 class="mb-0">
                    Order Items
                </h5>

            </div>


            <div class="card-body p-0">

                @if (!Model.Items.Any())
                {
                    <div class="alert alert-info m-3">
                        No products found in this order.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-hover align-middle mb-0">

                            <thead class="table-light">

                                <tr>

                                    <th>
                                        Product
                                    </th>

                                    <th>
                                        Code
                                    </th>

                                    <th class="text-center">
                                        Quantity
                                    </th>

                                    <th class="text-end">
                                        Unit Price
                                    </th>

                                    <th class="text-end">
                                        Total
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @foreach (var item in Model.Items)
                                {
                                    <tr>

                                        <td>

                                            <div class="fw-semibold">
                                                @item.ProductName
                                            </div>

                                        </td>


                                        <td>
                                            @item.ProductCode
                                        </td>


                                        <td class="text-center">
                                            @item.Quantity
                                        </td>


                                        <td class="text-end">
                                            @item.UnitPrice.ToString("0.00") AZN
                                        </td>


                                        <td class="text-end">

                                            <strong>
                                                @item.TotalPrice.ToString("0.00") AZN
                                            </strong>

                                        </td>

                                    </tr>
                                }

                            </tbody>


                            <tfoot>

                                <tr>

                                    <td colspan="4"
                                        class="text-end fw-semibold">

                                        Total:

                                    </td>

                                    <td class="text-end">

                                        <strong class="fs-5">

                                            @Model.TotalAmount.ToString("0.00") AZN

                                        </strong>

                                    </td>

                                </tr>

                            </tfoot>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================
         ACTIONS
    ========================== -->

    <div class="col-12">

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left me-1"></i>

            Back to Orders

        </a>

    </div>

</div>
