@model TVT.Core.Common.Pagination.PagedResult<TVT.Business.DTOs.Orders.OrderListDto>

@{
    ViewData["Title"] = "Orders";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">


    <div class="card-body border-bottom">

        <form method="get" class="row g-2" role="search">

            <div class="col-md-4">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>

            <div class="col-auto">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Reset
                </a>

            </div>

        </form>

    </div>

    <div class="card-header bg-white d-flex justify-content-between align-items-center">

        <h5 class="mb-0">
            Order List
        </h5>

        <div class="text-muted small">
            Total: @Model.TotalCount
        </div>

    </div>


    <div class="card-body p-0">

        @if (!Model.Items.Any())
        {
            <div class="alert alert-info m-3">
                No orders found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>

                            <th style="width:70px;">
                                Id
                            </th>

                            <th>
                                Customer
                            </th>

                            <th>
                                Phone
                            </th>

                            <th>
                                Email
                            </th>

                            <th style="width:130px;">
                                Total
                            </th>

                            <th style="width:130px;">
                                Status
                            </th>

                            <th style="width:150px;">
                                Created
                            </th>

                            <th class="text-center" style="width:120px;">
                                Actions
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var order in Model.Items)
                        {
                            <tr>

                                <td>
                                    @order.Id
                                </td>


                                <td>
                                    @order.CustomerName
                                </td>


                                <td>
                                    @order.Phone
                                </td>


                                <td>

                                    @if (!string.IsNullOrWhiteSpace(order.Email))
                                    {
                                        @order.Email
                                    }
                                    else
                                    {
                                        <span class="text-muted">
                                            -
                                        </span>
                                    }

                                </td>


                                <td>

                                    <strong>
                                        @order.TotalAmount.ToString("0.00") AZN
                                    </strong>

                                </td>


                                <td>

                                    @switch (order.Status)
                                    {
                                        case "Pending":

                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>

                                            break;


                                        case "Confirmed":

                                            <span class="badge bg-primary">
                                                Confirmed
                                            </span>

                                            break;


                                        case "Preparing":

                                            <span class="badge bg-info text-dark">
                                                Preparing
                                            </span>

                                            break;


                                        case "Shipped":

                                            <span class="badge bg-primary">
                                                Shipped
                                            </span>

                                            break;


                                        case "Delivered":

                                            <span class="badge bg-success">
                                                Delivered
                                            </span>

                                            break;


                                        case "Cancelled":

                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>

                                            break;


                                        default:

                                            <span class="badge bg-secondary">
                                                @order.Status
                                            </span>

                                            break;
                                    }

                                </td>


                                <td>
                                    @order.CreatedDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>


                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@order.Id"
                                       class="btn btn-sm btn-primary"
                                       title="Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }


        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-center py-3">

                <nav>
                    <ul class="pagination mb-0">

                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-search="@ViewBag.Search">
                                Previous
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-search="@ViewBag.Search">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-search="@ViewBag.Search">
                                Next
                            </a>
                        </li>

                    </ul>
                </nav>

            </div>
        }

    </div>

</div>
