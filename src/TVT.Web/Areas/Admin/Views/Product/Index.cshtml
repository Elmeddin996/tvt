@model List<TVT.Business.DTOs.Products.ProductListDto>
@{
    ViewData["Title"] = "Products";
}

<partial name="_PageHeader" />

<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Product List</h5>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Create"
           class="btn btn-success">
            <i class="bi bi-plus-lg"></i>
            Add Product
        </a>
    </div>

    <div class="card-body border-bottom">

        <form method="get" class="row g-2" role="search">

            <div class="col-md-4">
                <input type="text"
                       name="search"
                       value="@ViewBag.Search"
                       class="form-control"
                       placeholder="Search..."
                       autocomplete="off" />
            </div>

            <div class="col-auto">

                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i>
                    Search
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Reset
                </a>

            </div>

        </form>

    </div>

    <div class="card-body p-0">

        @if (!Model.Any())
        {
            <div class="alert alert-info m-3">
                No products found.
            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th style="width:70px;">Id</th>
                            <th style="width:90px;">Image</th>
                            <th>Code</th>
                            <th>Name</th>
                            <th>Category</th>
                            <th style="width:120px;">Price</th>
                            <th style="width:120px;">Stock</th>
                            <th>Created</th>
                            <th class="text-center" style="width:220px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var product in Model)
                        {
                            <tr>

                                <td>@product.Id</td>

                                <td>
                                    @if (!string.IsNullOrWhiteSpace(product.MainImage))
                                    {
                                        <img src="@product.MainImage"
                                             class="img-thumbnail"
                                             style="width:60px;height:60px;object-fit:contain;" />
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>

                                <td>@product.Code</td>

                                <td>@product.NameAz</td>

                                <td>@product.CategoryName</td>

                                <td>
                                    @product.Price.ToString("0.##")
                                </td>

                                <td>
                                    @if (product.StockQuantity == 0)
                                    {
                                        <span class="badge bg-danger">
                                            Out of Stock
                                        </span>
                                    }
                                    else if (product.StockQuantity <= 10)
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Low (@product.StockQuantity)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            @product.StockQuantity
                                        </span>
                                    }
                                </td>

                                <td>
                                    @product.CreatedDate.ToString("dd.MM.yyyy")
                                </td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Are you sure you want to delete this product?')">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

           
        }

    </div>

</div>
